{
  "version": 2,
  "regions": ["hnd1"],
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.6.2" },
    { "src": "/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(favicon\\.ico|robots\\.txt|mix-manifest\\.json)", "dest": "/public/$1" },
    { "src": "/(admin-das|css|front-asset|front-assets|js|phoenix-assets|uploads|vendor)/(.*)", "dest": "/public/$1/$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
